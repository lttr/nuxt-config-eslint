{
  "name": "@lttr/nuxt-config-eslint",
  "version": "0.4.2",
  "description": "An opinionated ESlint config for Nuxt apps",
  "license": "MIT",
  "repository": "github:lttr/nuxt-config-eslint",
  "author": "Lukas Trumm <lukas.trumm@gmail.com> (https://lukastrumm.com)",
  "keywords": [
    "eslint-config",
    "nuxt"
  ],
  "files": [
    "./index.js"
  ],
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "dev": "pnpx @eslint/config-inspector --config index.js",
    "release": "changelogen --release && pnpm publish && git push --follow-tags"
  },
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-flat-config-utils": "^2.1.4",
    "eslint-plugin-vue-scoped-css": "^2.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1"
  },
  "devDependencies": {
    "changelogen": "^0.6.2"
  }
}
